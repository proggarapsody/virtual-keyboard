  "narrative": {
    "northStar": "A smoked-glass keyboard workbench at dusk",
    "overview": "A personal keyboard workbench made of smoked glass and tactile caps. Rose and lavender landscape light sits behind dark translucent panels; soft white actions and restrained rose feedback keep the editor legible. Compact Manrope chrome frames a keyboard whose colors, fonts, sound, and press effects belong to its author.\n\nThe application is an operating surface: the keyboard remains the central object. Continuous library and inspector panels support editing; Play removes both sidebars. A locally bundled landscape and font supply the atmosphere without remote asset requests.",
    "keyCharacteristics": [
      "Smoked translucent panels over original dusk landscape light.",
      "Soft white pill actions, rose accents, and compact Manrope typography.",
      "Sculpted keyboard depth with selection and input-driven feedback."
    ],
    "rules": [
      {
        "name": "The Authored Color Rule",
        "body": "Keep interface materials separate from authored keyboard, canvas, legend, and effect values. Chrome and studio wallpaper never enter portable designs.",
        "section": "colors"
      },
      {
        "name": "The Two Type Domains Rule",
        "body": "Use Manrope for interface chrome. Keyboard legends retain the selectable authored font; do not export the interface font as a design setting.",
        "section": "typography"
      },
      {
        "name": "The Material Depth Rule",
        "body": "Use diffuse cast shadows, fine luminous rims, and backdrop blur for glass. Reserve keycap displacement for actual input feedback.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the shared semantic tokens and reusable controls on both the studio and design-system page.",
      "Do preserve physical keyboard proportions and expose scrolling when the board overflows.",
      "Do retain visible focus, explicit selection marks, save/error text, and reduced-motion behavior.",
      "Do derive preset previews from the actual editable presets."
    ],
    "donts": [
      "Don't merge authored colors, fonts, or geometry into editor chrome.",
      "Don't replace continuous inspectors with a grid of decorative cards.",
      "Don't add marketing eyebrows or decorative numbered section prefixes.",
      "Don't describe the input-driven listening bars as an audio analyzer."
    ]
  }
}
