  "narrative": {
    "northStar": "A quiet graphite workspace",
    "overview": "The editor surrounds an expressive keyboard with subdued, functional chrome. Dense controls and explicit status text support repeated editing; the keyboard carries the color, material, and press response. This is a code-led record of the implemented system, with ordinary visual choices inferred under the user's authorization.\n\nThe editor is an Operate surface and the player is an Experience surface. Player mode removes the side inspectors and keeps the keyboard, scratchpad, and listening controls. Background images are supplied by the user; the interface uses system fonts and requires no remote UI assets.",
    "keyCharacteristics": [
      "Graphite chrome with restrained blue actions and readable neutral text.",
      "Compact editing controls around a physically proportioned keyboard.",
      "Sculpted keycaps, explicit selection, and motion that responds to input."
    ],
    "rules": [
      {
        "name": "The Authored Color Rule",
        "body": "Keep chrome tokens separate from document-controlled keyboard, page, legend, and effect colors.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do keep expressive color and material on the keyboard while using quiet chrome around it.",
      "Do preserve physical keyboard geometry and provide visible controls when it overflows.",
      "Do retain the independent light/dark focus treatment and explicit selection text or marks.",
      "Do honor reduced motion and show editing, save, and error states with readable text."
    ],
    "donts": [
      "Don't replace editable keyboard values with fixed chrome tokens.",
      "Don't use color alone to distinguish selected keys.",
      "Don't add remote UI fonts or image dependencies to the existing system-font chrome."
    ]
  }
